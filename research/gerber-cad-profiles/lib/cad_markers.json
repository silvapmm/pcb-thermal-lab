{
  "_comment": "Markers that identify the program that wrote a file. scope: gerber, drill, support (any other text file of the set), name (file name), odb (ODB++ misc/info). weight 9 or more = the file names its generator in so many words (decisive); 4 to 8 = a quirk or a convention that points to the tool; 1 to 3 = shared by several tools. status: R = seen in a real file of the study (sets named), D = a documented statement (the source named), M = memory only, not seen.",
  "profiles": {
    "kicad": {"name": "KiCad", "kind": "ecad", "markers": [
      {"id": "g_x2", "scope": "gerber", "re": "TF\\.GenerationSoftware,\\s*KiCad,\\s*Pcbnew,\\s*([^*%\\r\\n]+)", "w": 10, "version": 1, "status": "R kicad5 to 9 sets"},
      {"id": "g_old", "scope": "gerber", "re": "Created by KiCad \\(PCBNEW ([^)]*)\\)", "w": 10, "version": 1, "status": "R kicad-older (4.0.6)"},
      {"id": "d_hdr", "scope": "drill", "re": "DRILL file \\{KiCad ?\\(?([^})]*)", "w": 10, "version": 1, "status": "R every KiCad drill"},
      {"id": "d_x2", "scope": "drill", "re": "(?i)#@! TF\\.GenerationSoftware,\\s*KiCad,\\s*Pcbnew,\\s*([^\\r\\n]+)", "w": 10, "version": 1, "status": "R kicad 5.99 to 9"},
      {"id": "odb", "scope": "odb", "re": "SAVE_APP=KiCad EDA ([\\d.]+)", "w": 10, "version": 1, "status": "R realboards-odb flat_hierarchy (9.0.3)"},

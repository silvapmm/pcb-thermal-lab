      {"id": "g_aper", "scope": "gerber", "re": "G04 APERTURE (BEGIN |END )?LIST\\*", "w": 3, "status": "R kicad 5.99 and later"},
      {"id": "n_cu", "scope": "name", "re": "-(F|B|In\\d+)[._](Cu)\\.[a-z]+$", "w": 3, "status": "R kicad-older, wc2"},
      {"id": "n_edge", "scope": "name", "re": "-Edge[._]Cuts\\.[a-z]+$", "w": 3, "status": "R"}

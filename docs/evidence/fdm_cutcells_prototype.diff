+    def _cut_edge_film(self, g0, S, ncov, edge_nodes, dx, dy, wx, wy):
+        """!
+        @brief Put the conduction from the node to the closest outline point in series with the edge film h_side (the same Robin treatment of a cut cell as `fvm.Network._cut_edge_film`).
+        @details g = H L / max(1 + H d / S_phys, EDGE_FILM_FLOOR), H = g0 / L the film per metre of edge, L the edge length in the control volume, d the signed distance from the
+                 node to the closest outline point (negative for a node outside the board), S_phys the sheet of the node without its cover. On a rectangle the border node is
+                 on the edge (d = 0), so only an outline board is changed. The ambient term is scaled with the conductance (g_amb is rebuilt from it), so a constant field is exact.
+        @param g0 Edge conductance of every node layer before the series term in W/K, shape (nl, ny, nx).
+        @param S Sheet conductance of every node layer (W/K, scaled by the node cover), shape (nl, ny, nx).
+        @param ncov Cover of every control volume by the board, shape (ny, nx).
+        @param edge_nodes Outline length in every control volume in m, shape (ny, nx).
+        @param dx Node spacing along x in m.
+        @param dy Node spacing along y in m.
+        @param wx Control-volume widths along x in m.
+        @param wy Control-volume heights along y in m.
+        @return Array of the same shape as g0.
+        """
+        b = self.problem.board
+        if not b.has_outline():
+            return g0
+        L = edge_nodes
+        H = np.zeros_like(g0)
+        np.divide(g0, L[None], out=H, where=L[None] > 0)
+        d = np.zeros((self.ny, self.nx))
+        cells = np.argwhere(L > 0)
+        if len(cells):
+            d[cells[:, 0], cells[:, 1]] = signed_distance_to_outline(b.outline, cells[:, 1] * dx, cells[:, 0] * dy)
+        sp_ = np.zeros_like(S[:g0.shape[0]])
+        np.divide(S[:g0.shape[0]], ncov[None], out=sp_, where=ncov[None] > 0)
+        with np.errstate(divide="ignore", invalid="ignore"):
+            fac = np.where(sp_ > 0, 1.0 + H * d[None] / sp_, 1.0)
+        fac = np.where(H > 0, np.maximum(fac, fvm.EDGE_FILM_FLOOR), 1.0)
+        return np.where((g0 > 0) & (L[None] > 0), H * L[None] / fac, g0)

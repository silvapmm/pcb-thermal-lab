{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(//Volumes/SSD/PROJETOS/**)",
      "Bash",
      "Bash(git *)",
      "Bash(gh *)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard origin*)",
      "Bash(git push origin --delete *)",
      "Bash(git push origin :*)",
      "Bash(git push --delete *)",
      "Bash(git push -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(git tag -d *)",
      "Bash(git tag --delete *)",
      "Bash(gh release delete*)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(~/.claude_pessoal/settings.json)",
      "Edit(~/.claude/settings.json)"
    ]
  }
}
